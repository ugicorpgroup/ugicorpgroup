{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": { "singularName": "page", "pluralName": "pages", "displayName": "Page", "description": "Hero and flexible sections for website pages" },
  "options": { "draftAndPublish": true },
  "attributes": {
    "title": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "title", "required": true },
    "heroEyebrow": { "type": "string" },
    "heroTitle": { "type": "string", "required": true },
    "heroDescription": { "type": "text" },
    "heroImage": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "sectionEyebrow": { "type": "string" },
    "sectionTitle": { "type": "string" },
    "sectionDescription": { "type": "text" },
    "sections": { "type": "component", "repeatable": true, "component": "shared.content-section" },
    "seoTitle": { "type": "string" },
    "seoDescription": { "type": "text" }
  }
}
